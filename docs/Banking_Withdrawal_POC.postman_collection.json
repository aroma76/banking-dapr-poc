          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8081",
          "path": [
            "api",
            "v1",
            "transactions",
            "withdraw"
          ]
        },
        "description": "Validation check. Expected: HTTP 400 Bad Request, message 'amount must be greater than zero'."
