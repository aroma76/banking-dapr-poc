<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron" agent="Mozilla/5.0" version="21.6.8" type="device"><diagram id="Banking_Architecture" name="Architecture (HLD + LLD)"><mxGraphModel dx="1200" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="960" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="10" value="&lt;b&gt;Banking Withdrawal POC — Unified Architecture (HLD + LLD)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#94A3B8;'&gt;High-Level Infrastructure &amp;amp; Container Topology (Top) | Low-Level Code Pipeline, Decision Flow &amp;amp; DB Schemas (Bottom)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#334155;fontColor=#FFFFFF;align=left;spacingLeft=16;shadow=1;" parent="1" vertex="1"><mxGeometry x="30" y="20" width="1140" height="50" as="geometry" /></mxCell><mxCell id="20" value="PART 1: HIGH-LEVEL DESIGN (HLD) — DOCKER CONTAINERS &amp;amp; NETWORK TOPOLOGY" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontStyle=1;fontColor=#334155;fontSize=12;" parent="1" vertex="1"><mxGeometry x="30" y="85" width="1140" height="310" as="geometry" /></mxCell><mxCell id="21" value="&lt;b style='font-size:13px;color:#1E3A8A;'&gt;Client&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Postman / cURL&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='background:#DBEAFE;color:#1E40AF;padding:2px 8px;border-radius:4px;font-size:10.5px;font-weight:bold;'&gt;HTTP POST&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;align=center;shadow=1;" parent="1" vertex="1"><mxGeometry x="50" y="155" width="120" height="85" as="geometry" /></mxCell><mxCell id="22" value="&lt;b style='color:#3730A3;font-size:11px;'&gt;Transaction Pod (Localhost)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#818CF8;strokeWidth=1.5;dashed=1;align=center;verticalAlign=top;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="210" y="120" width="190" height="245" as="geometry" /></mxCell><mxCell id="23" value="&lt;b style='color:#312E81;font-size:12px;'&gt;transaction-app&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#4F46E5;font-size:10.5px;'&gt;Spring Boot REST API&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#64748B;font-size:10px;'&gt;Port: &lt;b&gt;8081&lt;/b&gt; (Public)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;strokeWidth=1.5;align=center;shadow=1;" parent="1" vertex="1"><mxGeometry x="225" y="155" width="160" height="75" as="geometry" /></mxCell><mxCell id="24" value="&lt;b style='color:#831843;font-size:12px;'&gt;transaction-dapr&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#9D174D;font-size:10.5px;'&gt;Dapr Sidecar&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#64748B;font-size:10px;'&gt;Port: &lt;b&gt;3500&lt;/b&gt; (Localhost)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=1.5;align=center;shadow=1;" parent="1" vertex="1"><mxGeometry x="225" y="270" width="160" height="75" as="geometry" /></mxCell><mxCell id="25" value="&lt;b style='color:#78350F;font-size:12px;'&gt;dapr-placement&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#92400E;font-size:10px;'&gt;Service Discovery Router&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#64748B;font-size:10px;'&gt;Port: &lt;b&gt;50005&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;align=center;shadow=1;" parent="1" vertex="1"><mxGeometry x="485" y="135" width="170" height="70" as="geometry" /></mxCell><mxCell id="26" value="&lt;b style='color:#3730A3;font-size:11px;'&gt;Accounting Pod (Vault)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#818CF8;strokeWidth=1.5;dashed=1;align=center;verticalAlign=top;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="710" y="120" width="190" height="245" as="geometry" /></mxCell><mxCell id="27" value="&lt;b style='color:#312E81;font-size:12px;'&gt;accounting-app&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#4F46E5;font-size:10.5px;'&gt;Spring Boot Core Engine&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#64748B;font-size:10px;'&gt;Port: &lt;b&gt;8082&lt;/b&gt; (Internal)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;strokeWidth=1.5;align=center;shadow=1;" parent="1" vertex="1"><mxGeometry x="725" y="155" width="160" height="75" as="geometry" /></mxCell><mxCell id="28" value="&lt;b style='color:#831843;font-size:12px;'&gt;accounting-dapr&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#9D174D;font-size:10.5px;'&gt;Dapr Sidecar&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#64748B;font-size:10px;'&gt;Port: &lt;b&gt;3501&lt;/b&gt; (Localhost)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#EC4899;strokeWidth=1.5;align=center;shadow=1;" parent="1" vertex="1"><mxGeometry x="725" y="270" width="160" height="75" as="geometry" /></mxCell><mxCell id="29" value="&lt;b style='color:#064E3B;font-size:13px;'&gt;banking-postgres&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#047857;font-size:11px;'&gt;PostgreSQL 15&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#64748B;font-size:10px;'&gt;Port: &lt;b&gt;5432&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='color:#065F46;font-size:9.5px;'&gt;• accounts (balance &amp;gt;= 0)&lt;br/&gt;• withdrawal_transactions&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;align=center;shadow=1;" parent="1" vertex="1"><mxGeometry x="960" y="155" width="170" height="140" as="geometry" /></mxCell><mxCell id="101" value="&lt;b&gt;[1] POST /withdraw&lt;/b&gt;&lt;br/&gt;Port: 8081" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#2563EB;strokeWidth=2;fontSize=10;fontColor=#1E3A8A;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="21" target="23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="102" value="&lt;b&gt;[2] :3500&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#4F46E5;strokeWidth=2;fontSize=10;fontColor=#312E81;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="23" target="24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="103" value="lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.8;exitY=0;entryX=0;entryY=0.5;strokeColor=#D97706;strokeWidth=1.5;dashed=1;fontSize=9.5;fontColor=#92400E;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="24" target="25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="353" y="170" /></Array></mxGeometry></mxCell><mxCell id="104" value="&lt;b&gt;[3] Dapr Invocation Mesh&lt;/b&gt;&lt;br/&gt;(gRPC over banking-net)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#EC4899;strokeWidth=2.5;fontSize=10;fontColor=#831843;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="24" target="28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="105" value="&lt;b&gt;[4] :8082&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;strokeColor=#4F46E5;strokeWidth=2;fontSize=10;fontColor=#312E81;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="28" target="27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="106" value="&lt;b&gt;[5] SQL UPDATE &amp;amp; Lock&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.35;strokeColor=#059669;strokeWidth=2;fontSize=10;fontColor=#064E3B;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="27" target="29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="30" value="PART 2: LOW-LEVEL DESIGN (LLD) — EXECUTION PIPELINE, DECISION GATEWAYS &amp;amp; DATABASE SCHEMAS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontStyle=1;fontColor=#334155;fontSize=12;" parent="1" vertex="1"><mxGeometry x="30" y="415" width="1140" height="495" as="geometry" /></mxCell><mxCell id="31" value="&lt;b style='font-size:11.5px;color:#312E81;'&gt;1. REST Ingestion&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#4F46E5;'&gt;&lt;b&gt;TransactionController&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#475569;'&gt;• &lt;code&gt;POST /withdraw&lt;/code&gt;&lt;br/&gt;• Validates: &lt;code&gt;amount &amp;gt; 0&lt;/code&gt;&lt;br/&gt;• Currency: &lt;code&gt;'INR'&lt;/code&gt;&lt;br/&gt;• Receives: &lt;b&gt;WithdrawalRequest&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;(accountId, amount, &lt;b&gt;requestId&lt;/b&gt;)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;shadow=1;" parent="1" vertex="1"><mxGeometry x="50" y="455" width="195" height="135" as="geometry" /></mxCell><mxCell id="32" value="&lt;b style='font-size:11.5px;color:#312E81;'&gt;2. Service Invocation&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#4F46E5;'&gt;&lt;b&gt;TransactionService&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#475569;'&gt;• Calls Dapr Sidecar via RestTemplate:&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;localhost:3500/v1.0/invoke/&lt;/code&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;accounting-service/method/...&lt;/code&gt;&lt;br/&gt;• Forwards unique &lt;code&gt;requestId&lt;/code&gt;&lt;br/&gt;• Zero hardcoded service IPs&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;shadow=1;" parent="1" vertex="1"><mxGeometry x="275" y="455" width="200" height="135" as="geometry" /></mxCell><mxCell id="33" value="&lt;b style='font-size:11.5px;color:#312E81;'&gt;3. Validation &amp;amp; Idempotency&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#4F46E5;'&gt;&lt;b&gt;AccountingService&lt;/b&gt; [@Transactional]&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#475569;'&gt;• &lt;b&gt;Gate 1: Idempotency Check&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;txRepo.findByRequestId(reqId)&lt;/code&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;span style='color:#059669;'&gt;↳ If found: return cached receipt&lt;/span&gt;&lt;br/&gt;• &lt;b&gt;Gate 2: Account Existence&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;accountRepo.findByAccountId()&lt;/code&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;span style='color:#DC2626;'&gt;↳ If missing: throw 404&lt;/span&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;shadow=1;" parent="1" vertex="1"><mxGeometry x="505" y="455" width="210" height="135" as="geometry" /></mxCell><mxCell id="34" value="&lt;b style='font-size:11.5px;color:#064E3B;'&gt;4. Atomic Balance Deduct&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#059669;'&gt;&lt;b&gt;AccountRepository (PostgreSQL)&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#334155;'&gt;• &lt;b&gt;Atomic SQL Query:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;UPDATE accounts SET balance =&lt;/code&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;balance - :amt WHERE account_id =&lt;/code&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;:id AND balance &amp;gt;= :amt&lt;/code&gt;&lt;br/&gt;• &lt;span style='color:#D97706;'&gt;0 rows: INSUFFICIENT_BALANCE&lt;/span&gt;&lt;br/&gt;• &lt;span style='color:#059669;'&gt;1 row: Deduction locked &amp;amp; committed&lt;/span&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;shadow=1;" parent="1" vertex="1"><mxGeometry x="745" y="455" width="210" height="135" as="geometry" /></mxCell><mxCell id="35" value="&lt;b style='font-size:11.5px;color:#064E3B;'&gt;5. Audit Trail &amp;amp; Response&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#059669;'&gt;&lt;b&gt;TransactionRepository&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#334155;'&gt;• &lt;b&gt;Saves Audit Record:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;txRepo.save(record)&lt;/code&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;(transactionId, requestId, balance)&lt;br/&gt;• Returns &lt;b&gt;WithdrawalResponse:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;status: 'SUCCESS'&lt;/code&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;remainingBalance: 500.00&lt;/code&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;shadow=1;" parent="1" vertex="1"><mxGeometry x="985" y="455" width="170" height="135" as="geometry" /></mxCell><mxCell id="201" value="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#4F46E5;strokeWidth=1.5;fontSize=9.5;fontColor=#312E81;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="31" target="32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="202" value="Dapr gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#EC4899;strokeWidth=1.5;fontSize=9.5;fontColor=#831843;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="32" target="33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="203" value="proceed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#4F46E5;strokeWidth=1.5;fontSize=9.5;fontColor=#312E81;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="33" target="34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="204" value="1 row ok" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#059669;strokeWidth=1.5;fontSize=9.5;fontColor=#064E3B;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="34" target="35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="36" value="&lt;b style='font-size:12px;color:#1E293B;'&gt;Decision Gateway &amp;amp; Outcome Handlers&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10px;line-height:1.5;color:#334155;'&gt;• &lt;b style='color:#059669;'&gt;Case 1: Duplicate requestId detected in Gate 1&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;↳ Return HTTP 200 with cached transaction receipt (Zero double debit)&lt;br/&gt;&lt;br/&gt;• &lt;b style='color:#DC2626;'&gt;Case 2: Account ID not found in Gate 2&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;↳ Return HTTP 404 NOT_FOUND (&amp;quot;Account ACC001 does not exist&amp;quot;)&lt;br/&gt;&lt;br/&gt;• &lt;b style='color:#D97706;'&gt;Case 3: Atomic SQL returns 0 rows updated&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;↳ Return HTTP 400 INSUFFICIENT_BALANCE (&amp;quot;Balance lower than withdrawal&amp;quot;)&lt;br/&gt;&lt;br/&gt;• &lt;b style='color:#059669;'&gt;Case 4: Atomic SQL returns 1 row updated&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;↳ Proceed to Step 5, save audit row, and commit transaction&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=1;" parent="1" vertex="1"><mxGeometry x="50" y="620" width="390" height="220" as="geometry" /></mxCell><mxCell id="37" value="&lt;b style='font-size:12px;color:#064E3B;'&gt;TABLE: accounts (PostgreSQL)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#059669;'&gt;Core account balances &amp;amp; overdraft protection&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10px;line-height:1.45;color:#334155;'&gt;• &lt;b&gt;id:&lt;/b&gt; BIGSERIAL [PRIMARY KEY]&lt;br/&gt;• &lt;b&gt;account_id:&lt;/b&gt; VARCHAR(50) [UNIQUE]&lt;br/&gt;• &lt;b&gt;balance:&lt;/b&gt; NUMERIC(15,2)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b style='color:#047857;'&gt;↳ CHECK (balance &amp;gt;= 0)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;currency:&lt;/b&gt; CHAR(3) ('INR')&lt;br/&gt;• &lt;b&gt;version:&lt;/b&gt; BIGINT [Optimistic Lock]&lt;br/&gt;• &lt;b&gt;created_at, updated_at:&lt;/b&gt; TIMESTAMP&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=1;" parent="1" vertex="1"><mxGeometry x="470" y="620" width="310" height="220" as="geometry" /></mxCell><mxCell id="38" value="&lt;b style='font-size:12px;color:#064E3B;'&gt;TABLE: withdrawal_transactions&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#059669;'&gt;Immutable audit log &amp;amp; idempotency registry&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10px;line-height:1.45;color:#334155;'&gt;• &lt;b&gt;id:&lt;/b&gt; BIGSERIAL [PRIMARY KEY]&lt;br/&gt;• &lt;b&gt;transaction_id:&lt;/b&gt; VARCHAR(100) [UNIQUE]&lt;br/&gt;• &lt;b&gt;request_id:&lt;/b&gt; VARCHAR(100) [UNIQUE]&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b style='color:#2563EB;'&gt;↳ Enforces idempotency in DB&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;account_id:&lt;/b&gt; VARCHAR(50) [FK &amp;rarr; accounts]&lt;br/&gt;• &lt;b&gt;amount:&lt;/b&gt; NUMERIC(15,2)&lt;br/&gt;• &lt;b&gt;remaining_balance:&lt;/b&gt; NUMERIC(15,2)&lt;br/&gt;• &lt;b&gt;status:&lt;/b&gt; VARCHAR(20) ('SUCCESS')&lt;br/&gt;• &lt;b&gt;created_at:&lt;/b&gt; TIMESTAMP&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;shadow=1;" parent="1" vertex="1"><mxGeometry x="810" y="620" width="345" height="220" as="geometry" /></mxCell><mxCell id="205" value="&lt;b&gt;UPDATE balance&lt;/b&gt;&lt;br/&gt;(Row Lock)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#059669;strokeWidth=2;fontSize=9.5;fontColor=#064E3B;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="34" target="37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="206" value="&lt;b&gt;INSERT Audit Record&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#059669;strokeWidth=2;fontSize=9.5;fontColor=#064E3B;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="35" target="38"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="207" value="FK: account_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;strokeColor=#64748B;strokeWidth=1.5;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="38" target="37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="39" value="&lt;b&gt;3 Key Engineering Guarantees:&lt;/b&gt; &amp;nbsp; 1. &lt;b&gt;Zero Hardcoded IPs:&lt;/b&gt; Microservices discover and invoke via Dapr sidecars &amp;nbsp;|&amp;nbsp; 2. &lt;b&gt;Zero Race Conditions:&lt;/b&gt; Atomic SQL UPDATE guard prevents negative balance under high concurrency &amp;nbsp;|&amp;nbsp; 3. &lt;b&gt;Strict Idempotency:&lt;/b&gt; Unique requestId prevents duplicate billing" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=center;fontSize=10;fontColor=#334155;shadow=1;" parent="1" vertex="1"><mxGeometry x="50" y="860" width="1105" height="32" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>